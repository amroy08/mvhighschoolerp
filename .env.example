# MVHS School ERP – Environment Variables
# Copy this file to .env and fill in the values before running the application.
# NEVER commit the actual .env file to Git.

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://mvhs_user:mvhs_pass@localhost:5432/mvhs_erp?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Authentication ─────────────────────────────────────────────────────────────
# Use a strong random value in production (min 64 characters)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false  # true in production

# ─── Aadhaar Encryption ─────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM. Generate with: openssl rand -hex 32
AADHAAR_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
# IV for encryption (16 bytes hex). Generate with: openssl rand -hex 16
AADHAAR_ENCRYPTION_IV=CHANGE_ME_16_BYTE_HEX_IV

# ─── TOTP Encryption ────────────────────────────────────────────────────────────
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# ─── S3 / Object Storage (MinIO in dev, AWS S3 in production) ───────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=mvhs-erp-dev
S3_REGION=ap-south-1
S3_PUBLIC_URL=http://localhost:9000

# ─── Email (SMTP) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@mvhighschool.edu.in
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_NAME=Marwari Vidyalaya ERP
SMTP_FROM_EMAIL=noreply@mvhighschool.edu.in

# ─── Frontend ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=MVHS School ERP
NEXT_PUBLIC_SCHOOL_NAME=Marwari Vidyalaya High School
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR

# ─── CORS ───────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Application Settings ───────────────────────────────────────────────────────
# Upload limits
MAX_FILE_SIZE_BYTES=5242880  # 5 MB
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ─── Seed Safety Guard ───────────────────────────────────────────────────────────
# Set to true only when intentionally seeding a non-local database.
ALLOW_DB_SEED_RESET=false
